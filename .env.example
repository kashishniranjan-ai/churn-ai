# Copy to .env and adjust. Every variable has a working default, so the app
# runs without a .env file — this exists only to override those defaults.

# ---- API (app/main.py) ----
# Directory holding customer_prediction_pipeline.joblib, feature_metadata.json
# and training_metrics.json. Relative paths resolve from the process CWD.
# MODEL_DIR=./model

# Comma-separated browser origins allowed to call the API (CORS). The Streamlit
# dashboard talks to the API server-side, so it is unaffected by this setting.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---- Dashboard (frontend/dashboard.py) ----
# Base URL of the API. Inside docker compose the service name is the host:
# API_URL=http://api:8000
# API_URL=http://localhost:8000
